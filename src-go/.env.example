# Local defaults
NANOCLAW_GO_VM_BACKEND=simulated
NANOCLAW_GO_VM_NET_MODE=none

# Remote target (required for scripts/remote-firecracker.sh)
# Example: root@100.64.0.10
NANOCLAW_REMOTE_HOST=
NANOCLAW_REMOTE_WORKDIR=/root/nanoclaw-buffalo
NANOCLAW_REMOTE_SRC_GO_DIR=/root/nanoclaw-buffalo/src-go

# Remote Firecracker/runtime paths
NANOCLAW_REMOTE_FIRECRACKER_BIN=/opt/firecracker/bin/firecracker
NANOCLAW_REMOTE_KERNEL_IMAGE=/opt/firecracker/images/vmlinux.bin
NANOCLAW_REMOTE_ROOTFS_IMAGE=/opt/firecracker/images/bionic.rootfs.ext4
NANOCLAW_REMOTE_VM_NET_MODE=none

